{
  "name": "dm-shopping-cart",
  "version": "1.0.0",
  "homepage": ".",
  "description": "DM Shopping Cart for tabletop RPG games",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "package": "electron-builder"
  },
  "keywords": [
    "electron",
    "react",
    "rpg",
    "shopping-cart"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "electron": "^44.7.1",
    "electron-builder": "^26.5.0",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sprintf-js": "^1.1.3"
  },
  "build": {
    "appId": "com.dmshoppingcart.app",
    "productName": "DM Shopping Cart",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "index.html",
      "player.html",
      "dist/**/*",
      "node_modules/**/*",
      "Item Inventory List.csv",
      "Logo.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "Logo.ico"
    }, 
    "afterPack": "scripts/remove-locales.js"
  },
  "allowScripts": {
    "electron@30.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
